<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.mapper.AiMessageMapper">

    <select id="selectById" resultType="AiMessage">
        SELECT * FROM ai_message WHERE id = #{id}
    </select>

    <select id="selectBySessionId" resultType="AiMessage">
        SELECT * FROM ai_message WHERE session_id = #{sessionId} ORDER BY create_time ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_message(session_id, role, content, create_time)
        VALUES(#{sessionId}, #{role}, #{content}, #{createTime})
    </insert>

    <delete id="deleteBySessionId">
        DELETE FROM ai_message WHERE session_id = #{sessionId}
    </delete>

</mapper>
